---
const stripePaymentUrl = "https://buy.stripe.com/28EdRa9Buc6QfLL6DjgYU00";
---

<!-- Top Demo Preview Banner -->
<div id="preview-banner" class="preview-banner">
  <div class="banner-container">
    <div class="banner-info">
      <span class="preview-tag">Client Preview</span>
      <span class="banner-msg">Demo draft for <strong>Walsh Garden & Tree Care</strong></span>
    </div>

    <div class="banner-timer">
      <span class="timer-icon">⏳</span>
      <span class="timer-label">Access expires in:</span>
      <span id="countdown-display" class="timer-digits">72:00:00</span>
    </div>

    <div class="banner-action">
      <a 
        href={stripePaymentUrl} 
        target="_blank" 
        rel="noopener noreferrer" 
        class="banner-cta-btn"
      >
        <span>Activate & Claim .IE Domain →</span>
      </a>
    </div>
  </div>
</div>

<!-- Expired Lock Screen Modal -->
<div id="preview-expired-lock" class="expired-lock-screen" style="display: none;">
  <div class="lock-card">
    <div class="lock-icon">🔒</div>
    <h2>48-Hour Preview Period Has Ended</h2>
    <p class="lock-desc">
      The temporary draft preview for <strong>Walsh Garden & Tree Care</strong> is currently inactive.
    </p>
    
    <div class="lock-perks">
      <div class="perk-item">✓ Official <strong>.ie</strong> domain registration</div>
      <div class="perk-item">✓ Nationwide Google Business Profile setup</div>
      <div class="perk-item">✓ Unlimited hosting & monthly photo updates</div>
      <div class="perk-item">✓ Direct phone & WhatsApp lead generation</div>
    </div>

    <a 
      href={stripePaymentUrl} 
      target="_blank" 
      rel="noopener noreferrer" 
      class="btn-activate-large"
    >
      Activate Plan & Launch Website (€50/mo)
    </a>

    <p class="lock-note">
      Once activated, your official domain will be linked and your website published live immediately.
    </p>
  </div>
</div>

<style>
  .preview-banner {
    background: linear-gradient(90deg, #1b281f 0%, #153222 100%);
    color: #ffffff;
    border-bottom: 2px solid var(--color-accent);
    padding: 0.65rem 1rem;
    font-size: 0.875rem;
    position: sticky;
    top: 0;
    z-index: 9999;
    box-shadow: 0 4px 15px rgba(0, 0, 0, 0.25);
  }

  .banner-container {
    max-width: 1200px;
    margin: 0 auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .banner-info {
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }

  .preview-tag {
    background-color: var(--color-accent);
    color: #1b1b1b;
    font-weight: 800;
    font-size: 0.725rem;
    padding: 0.2rem 0.6rem;
    border-radius: var(--radius-full);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .banner-msg {
    color: #e2e8f0;
    font-size: 0.85rem;
  }

  .banner-timer {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    background: rgba(0, 0, 0, 0.4);
    padding: 0.3rem 0.8rem;
    border-radius: var(--radius-full);
    border: 1px solid rgba(212, 160, 23, 0.4);
  }

  .timer-icon {
    font-size: 0.95rem;
  }

  .timer-label {
    font-size: 0.8rem;
    color: #cbd5e1;
  }

  .timer-digits {
    font-family: monospace;
    font-weight: 800;
    color: var(--color-accent);
    font-size: 0.95rem;
    letter-spacing: 0.05em;
  }

  .banner-cta-btn {
    background-color: #25D366;
    color: #ffffff;
    font-family: var(--font-heading);
    font-weight: 800;
    font-size: 0.85rem;
    padding: 0.45rem 1.15rem;
    border-radius: var(--radius-full);
    transition: transform 0.2s ease, background-color 0.2s ease;
    white-space: nowrap;
    display: inline-flex;
    align-items: center;
    box-shadow: 0 2px 10px rgba(37, 211, 102, 0.35);
  }

  .banner-cta-btn:hover {
    background-color: #1da851;
    transform: translateY(-1px);
    color: #ffffff;
  }

  @media (max-width: 820px) {
    .banner-container {
      justify-content: center;
      text-align: center;
    }
    .banner-info {
      width: 100%;
      justify-content: center;
    }
    .banner-action {
      width: 100%;
    }
    .banner-cta-btn {
      width: 100%;
      justify-content: center;
      padding: 0.65rem 1rem;
    }
  }

  /* Full screen expired lock */
  .expired-lock-screen {
    position: fixed;
    inset: 0;
    background: rgba(15, 23, 42, 0.96);
    backdrop-filter: blur(12px);
    z-index: 100000;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 1.5rem;
  }

  .lock-card {
    background: #ffffff;
    border-radius: var(--radius-lg);
    padding: 3rem 2.5rem;
    max-width: 520px;
    width: 100%;
    text-align: center;
    box-shadow: 0 25px 50px rgba(0, 0, 0, 0.4);
    border: 2px solid var(--color-accent);
  }

  .lock-icon {
    font-size: 3.5rem;
    line-height: 1;
    margin-bottom: 1rem;
  }

  .lock-card h2 {
    font-size: 1.75rem;
    color: var(--color-dark);
    margin-bottom: 0.75rem;
    line-height: 1.25;
  }

  .lock-desc {
    color: var(--color-gray);
    font-size: 1rem;
    line-height: 1.5;
    margin-bottom: 1.5rem;
  }

  .lock-perks {
    background: var(--color-gray-light);
    border-radius: var(--radius-md);
    padding: 1.25rem;
    margin-bottom: 1.75rem;
    text-align: left;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    font-size: 0.925rem;
    color: var(--color-dark);
  }

  .perk-item {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .btn-activate-large {
    display: block;
    background: linear-gradient(135deg, var(--color-primary) 0%, var(--color-primary-dark) 100%);
    color: #ffffff;
    font-family: var(--font-heading);
    font-weight: 800;
    font-size: 1.05rem;
    padding: 1rem 1.5rem;
    border-radius: var(--radius-full);
    text-decoration: none;
    box-shadow: 0 4px 15px rgba(45, 106, 79, 0.4);
    transition: transform 0.2s ease;
  }

  .btn-activate-large:hover {
    transform: translateY(-2px);
    color: #ffffff;
  }

  .lock-note {
    margin-top: 1.25rem;
    font-size: 0.8rem;
    color: var(--color-gray);
    line-height: 1.4;
  }
</style>

<script>
  // 48-Hour Timer Logic
  const STORAGE_KEY = 'walsh_preview_expiry_v2';
  const DURATION_MS = 48 * 60 * 60 * 1000; // 48 hours

  let expiryTimestamp = localStorage.getItem(STORAGE_KEY);

  if (!expiryTimestamp) {
    // Set expiry from first open
    expiryTimestamp = (Date.now() + DURATION_MS).toString();
    localStorage.setItem(STORAGE_KEY, expiryTimestamp);
  }

  const targetTime = parseInt(expiryTimestamp, 10);
  const display = document.getElementById('countdown-display');
  const lockScreen = document.getElementById('preview-expired-lock');
  const banner = document.getElementById('preview-banner');

  function updateCountdown() {
    const now = Date.now();
    const remaining = targetTime - now;

    if (remaining <= 0) {
      if (display) display.textContent = '00:00:00 (Expired)';
      if (lockScreen) lockScreen.style.display = 'flex';
      document.body.style.overflow = 'hidden';
      return;
    }

    const hours = Math.floor(remaining / (1000 * 60 * 60));
    const minutes = Math.floor((remaining % (1000 * 60 * 60)) / (1000 * 60));
    const seconds = Math.floor((remaining % (1000 * 60)) / 1000);

    const pad = (n: number) => (n < 10 ? '0' + n : n.toString());

    if (display) {
      display.textContent = `${pad(hours)}h ${pad(minutes)}m ${pad(seconds)}s`;
    }
  }

  updateCountdown();
  setInterval(updateCountdown, 1000);
</script>
