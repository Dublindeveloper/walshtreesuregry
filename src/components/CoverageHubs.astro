---
import coverage from '../data/coverage.json';

interface Props {
  showTitle?: boolean;
}

const { showTitle = true } = Astro.props;
---

<section class="coverage-section">
  <div class="container">
    {showTitle && (
      <div class="section-header">
        <span class="badge badge-gold">🇮🇪 All 4 Provinces</span>
        <h2>Weekly Nationwide Coverage Across Ireland</h2>
        <p>
          Walsh Garden and Tree Care operates dedicated maintenance and tree surgery routes throughout Ireland every week. Wherever your property is located, our fleet and crew are equipped to assist you.
        </p>
      </div>
    )}

    <div class="coverage-grid">
      {coverage.map((hub) => (
        <div class="hub-card">
          <div class="hub-header" style={`border-left-color: ${hub.color};`}>
            <span class="hub-badge" style={`background-color: ${hub.color}15; color: ${hub.color};`}>
              {hub.badge}
            </span>
            <h3 class="hub-title">{hub.name}</h3>
          </div>
          <p class="hub-desc">{hub.description}</p>
          <div class="counties-wrap">
            <span class="counties-label">Counties Served:</span>
            <ul class="counties-list">
              {hub.counties.map((county) => (
                <li class="county-tag">{county}</li>
              ))}
            </ul>
          </div>
          <div class="hub-footer">
            <a 
              href={`https://wa.me/353894494281?text=${encodeURIComponent(`Hi John, I am located in ${hub.name} and would like to enquire about your next route in my area.`)}`}
              target="_blank"
              rel="noopener noreferrer"
              class="hub-cta"
            >
              <span>Book on {hub.name} Route →</span>
            </a>
          </div>
        </div>
      ))}
    </div>

    <div class="nationwide-banner">
      <div class="banner-icon">🚐</div>
      <div class="banner-text">
        <h4>Don't see your specific town or village listed?</h4>
        <p>We service all rural, suburban, and commercial locations across Ireland. If you have trees, hedges, or a garden needing work, get in touch today.</p>
      </div>
      <a href="tel:+353894494281" class="btn btn-secondary banner-btn">
        Call 089 449 4281
      </a>
    </div>
  </div>
</section>

<style>
  .coverage-section {
    padding: 4.5rem 0;
    background-color: #f8faf9;
  }

  .coverage-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
    margin-bottom: 2.5rem;
  }

  @media (min-width: 640px) {
    .coverage-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .coverage-grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  .hub-card {
    background: #ffffff;
    border-radius: var(--radius-md);
    padding: 1.75rem;
    box-shadow: var(--shadow-sm);
    border: 1px solid var(--color-border);
    display: flex;
    flex-direction: column;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }

  .hub-card:hover {
    transform: translateY(-3px);
    box-shadow: var(--shadow-md);
  }

  .hub-header {
    border-left: 4px solid var(--color-primary);
    padding-left: 0.75rem;
    margin-bottom: 1rem;
  }

  .hub-badge {
    display: inline-block;
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    padding: 0.2rem 0.6rem;
    border-radius: var(--radius-sm);
    margin-bottom: 0.35rem;
  }

  .hub-title {
    font-size: 1.35rem;
    color: var(--color-dark);
  }

  .hub-desc {
    font-size: 0.875rem;
    color: var(--color-gray);
    line-height: 1.5;
    margin-bottom: 1.25rem;
  }

  .counties-wrap {
    margin-bottom: 1.5rem;
    flex-grow: 1;
  }

  .counties-label {
    display: block;
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    color: var(--color-gray-dark);
    margin-bottom: 0.5rem;
    letter-spacing: 0.05em;
  }

  .counties-list {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  .county-tag {
    background: var(--color-gray-light);
    color: var(--color-dark);
    font-size: 0.8rem;
    font-weight: 600;
    padding: 0.25rem 0.55rem;
    border-radius: var(--radius-sm);
    border: 1px solid rgba(0, 0, 0, 0.05);
  }

  .hub-footer {
    padding-top: 1rem;
    border-top: 1px solid var(--color-border);
  }

  .hub-cta {
    font-family: var(--font-heading);
    font-size: 0.875rem;
    font-weight: 700;
    color: var(--color-primary);
    display: inline-block;
    transition: transform 0.2s ease, color 0.2s ease;
  }

  .hub-cta:hover {
    color: var(--color-primary-dark);
    transform: translateX(3px);
  }

  .nationwide-banner {
    background: #ffffff;
    border: 2px dashed var(--color-primary);
    border-radius: var(--radius-lg);
    padding: 1.75rem 2rem;
    display: flex;
    align-items: center;
    gap: 1.5rem;
    flex-direction: column;
    text-align: center;
  }

  @media (min-width: 768px) {
    .nationwide-banner {
      flex-direction: row;
      text-align: left;
    }
  }

  .banner-icon {
    font-size: 2.5rem;
    line-height: 1;
    flex-shrink: 0;
  }

  .banner-text {
    flex-grow: 1;
  }

  .banner-text h4 {
    font-size: 1.15rem;
    margin-bottom: 0.35rem;
    color: var(--color-dark);
  }

  .banner-text p {
    font-size: 0.925rem;
    color: var(--color-gray);
    margin: 0;
  }

  .banner-btn {
    flex-shrink: 0;
    white-space: nowrap;
    font-size: 0.95rem;
    padding: 0.75rem 1.5rem;
  }
</style>
