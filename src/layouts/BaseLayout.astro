---
import SEOHead from '../components/SEOHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import MobileCTABar from '../components/MobileCTABar.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  ogImage?: string;
  canonicalUrl?: string;
}

const { title, description, ogImage, canonicalUrl } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <SEOHead 
      title={title} 
      description={description} 
      ogImage={ogImage} 
      canonicalUrl={canonicalUrl} 
    />
  </head>
  <body>
    <Header />
    <main id="main-content">
      <slot />
    </main>
    <Footer />
    <MobileCTABar />
  </body>
</html>

<style>
  #main-content {
    flex: 1 0 auto;
    width: 100%;
  }
</style>
